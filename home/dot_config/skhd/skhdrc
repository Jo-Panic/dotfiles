# Changing Window Focus

# change window focus within space
alt - down : yabai -m window --focus south
alt - up : yabai -m window --focus north
alt - left : yabai -m window --focus west
alt - right : yabai -m window --focus east

# change focus between external displays (left and right)
alt - s: yabai -m display --focus west
alt - g: yabai -m display --focus east

# Modifying the layout

# rotate layout clockwise
shift + alt - r : yabai -m space --rotate 270

# flip along y-axis
shift + alt - y : yabai -m space --mirror y-axis

# flip along x-axis
shift + alt - x : yabai -m space --mirror x-axis

# toggle window float
shift + alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Modifying Window Size

# maximize a window
shift + alt - m : yabai -m window --toggle zoom-fullscreen

# balance out tree of windows (resize to occupy same area)
shift + alt - e : yabai -m space --balance

# Moving windows Around

# swap windows
shift + alt - down : yabai -m window --swap south
shift + alt - up : yabai -m window --swap north
shift + alt - left : yabai -m window --swap west
shift + lalt - right : yabai -m window --swap east

# move window and split
ctrl + alt - down : yabai -m window --warp south
ctrl + alt - up : yabai -m window --warp north
ctrl + alt - left : yabai -m window --warp west
ctrl + alt - right : yabai -m window --warp east

ctrl - left  : yabai -m space --focus prev
ctrl - right : yabai -m space --focus next

# move window to display left and right
shift + alt - s : yabai -m window --display west; yabai -m display --focus west;
shift + alt - g : yabai -m window --display east; yabai -m display --focus east;

# move window to prev and next space
shift + alt - p : yabai -m window --space prev;
shift + alt - n : yabai -m window --space next;

# move window to space
# We use a keycode (0xnn). The key code can be osbserved launching skhd -o
lshift + lalt - 0x12 : yabai -m window --space 1;
lshift + lalt - 0x13 : yabai -m window --space 2;
lshift + lalt - 0x14 : yabai -m window --space 3;
lshift + lalt - 0x15 : yabai -m window --space 4;
lshift + lalt - 0x17 : yabai -m window --space 5;
lshift + lalt - 0x16 : yabai -m window --space 6;
lshift + lalt - 0x1A : yabai -m window --space 7;
lshift + lalt - 0x1C : yabai -m window --space 8;

# ── Keys for launching / switching apps ──────────────────────
# Lancement via wm-launch-app : pré-focus du space cible défini par
# la règle yabai correspondante, puis open -a.
# Évite le race condition borders/yabai au cold-start.
# Source unique de vérité app→space : règles yabai dans yabairc.
cmd - return                : ~/.local/bin/wm-launch-app Ghostty
lshift + lalt + cmd - o     : ~/.local/bin/wm-launch-app Obsidian
lshift + lalt + cmd - m     : ~/.local/bin/wm-launch-app "Proton Mail"
lshift + lalt + cmd - b     : ~/.local/bin/wm-launch-app "Brave Browser"
lshift + lalt + cmd - f     : ~/.local/bin/wm-launch-app Firefox
lshift + lalt + cmd - u     : ~/.local/bin/wm-launch-app "Mullvad Browser"
lshift + lalt + cmd - t     : ~/.local/bin/wm-launch-app "Tor Browser"
lshift + lalt + cmd - p     : ~/.local/bin/wm-launch-app "Affinity Photo 2"

# Resize focused window — direction = sens du déplacement du bord
cmd + ctrl - right : ~/.local/bin/yabai-resize right 20
cmd + ctrl - left  : ~/.local/bin/yabai-resize left  20
cmd + ctrl - up    : ~/.local/bin/yabai-resize up    20
cmd + ctrl - down  : ~/.local/bin/yabai-resize down  20
