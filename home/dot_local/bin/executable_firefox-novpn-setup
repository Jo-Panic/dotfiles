#!/usr/bin/env bash
# ~/.local/bin/firefox-novpn-setup
#
# Prépare « Firefox (hors VPN) », équivalent macOS de firefox-novpn.desktop
# (arch-dotfiles). Idempotent : relançable à volonté pour tout réparer.
#
#   1. ~/.local/bin/mullvad-exclude, compilé en natif depuis
#      ~/.local/share/mullvad-exclude/mullvad-exclude.c
#      Sur macOS, Mullvad exclut par chemin exact d'exécutable, et
#      l'exclusion se transmet aux processus enfants, y compris à travers
#      exec. Exclure ce binaire donne l'équivalent du mullvad-exclude
#      Linux :  mullvad-exclude <commande> [args…]
#      Un script ne conviendrait pas : pour un script, macOS déclare
#      l'interpréteur (/bin/bash) comme exécutable. Une copie de
#      /usr/bin/env non plus : elle tourne sous Rosetta, et Firefox avec
#      (cf. mullvad-exclude.c). Une telle copie est remplacée ici.
#   2. Profil Firefox « novpn »
#   3. Préférences du profil : user.js commun, userChrome.css commun
#      suivi de la surcouche userChrome-novpn.css
#   4. Lanceur Spotlight ~/Applications/Firefox (hors VPN).app :
#      exécutable natif compilé depuis ~/.local/share/firefox-novpn/
#      launcher.c (un script y serait lancé sous Rosetta), icône copiée
#      depuis Firefox.app, signature ad hoc, enregistrement LaunchServices
#   5. Mullvad : exclusion de mullvad-exclude + split tunneling actif
#      (Mullvad doit avoir l'Accès complet au disque, cf. Réglages
#      Système → Confidentialité et sécurité)
#
# Appelé par run_onchange_after_setup-firefox-novpn.sh (chezmoi apply) et
# par ~/.local/bin/firefox-novpn quand un prérequis manque.

set -euo pipefail

FIREFOX_APP="/Applications/Firefox.app"
FIREFOX="$FIREFOX_APP/Contents/MacOS/firefox"
EXCLUDE="$HOME/.local/bin/mullvad-exclude"
EXCLUDE_SRC="$HOME/.local/share/mullvad-exclude/mullvad-exclude.c"
MULLVAD="/usr/local/bin/mullvad"
FF="$HOME/Library/Application Support/Firefox"
LAUNCHER="$HOME/Applications/Firefox (hors VPN).app"
LAUNCHER_BIN="$LAUNCHER/Contents/MacOS/firefox-novpn"
LAUNCHER_SRC="$HOME/.local/share/firefox-novpn/launcher.c"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

USERJS="$HOME/.config/firefox/user.js"
USERCHROME="$HOME/.config/firefox/chrome/userChrome.css"
USERCHROME_NOVPN="$HOME/.config/firefox/chrome/userChrome-novpn.css"

# Architecture native de la machine, même si ce script tourne sous Rosetta
if [[ $(sysctl -n hw.optional.arm64 2>/dev/null) == 1 ]]; then
  ARCH=arm64
else
  ARCH=x86_64
fi

# build <source.c> <binaire> : compile en natif si le binaire est absent,
# plus ancien que la source, ou d'une autre architecture (ancienne copie
# de /usr/bin/env, « x86_64 arm64e » pour lipo ; ancien script…)
build() {
  local src=$1 out=$2 tmp
  if [[ -x $out && ! $src -nt $out &&
    $(lipo -archs "$out" 2>/dev/null) == "$ARCH" ]]; then
    return 0
  fi
  xcode-select -p >/dev/null 2>&1 || {
    echo "  ✗ outils de compilation absents : xcode-select --install" >&2
    return 1
  }
  mkdir -p "$(dirname "$out")"
  # Fichier temporaire puis mv, pour un nouvel inode : réécrire en place
  # un binaire signé peut le faire tuer (Killed: 9) au lancement suivant.
  tmp=$(mktemp "$out.XXXXXX")
  if ! cc -arch "$ARCH" -O2 -Wall -o "$tmp" "$src"; then
    rm -f "$tmp"
    echo "  ✗ compilation impossible : $src" >&2
    return 1
  fi
  chmod 755 "$tmp"
  mv -f "$tmp" "$out"
  echo "  → $out compilé ($ARCH natif)"
}

echo "Firefox hors VPN…"

[[ -x $FIREFOX ]] || {
  echo "  ✗ Firefox introuvable ($FIREFOX_APP) : brew install --cask firefox" >&2
  exit 1
}

# ── 1. mullvad-exclude ───────────────────────────────────────
build "$EXCLUDE_SRC" "$EXCLUDE" || exit 1

# ── 2. Profil novpn ──────────────────────────────────────────
if ! compgen -G "$FF/Profiles/*.novpn" >/dev/null; then
  "$FIREFOX" -CreateProfile novpn >/dev/null
  echo "  → profil novpn créé"
fi

# ── 3. Préférences du profil ─────────────────────────────────
# Le profil novpn échappe à run_onchange_after_deploy-firefox-prefs
# (qui ne cible que *.default-release et *.default) : déployé ici.
for p in "$FF"/Profiles/*.novpn; do
  [[ -d $p ]] || continue
  cp "$USERJS" "$p/user.js"
  mkdir -p "$p/chrome"
  cat "$USERCHROME" "$USERCHROME_NOVPN" >"$p/chrome/userChrome.css"
  echo "  → $p"
done

# ── 4. Lanceur Spotlight ─────────────────────────────────────
if [[ -d $LAUNCHER ]]; then
  # Exécutable natif : remplace l'ancien script, lancé sous Rosetta
  build "$LAUNCHER_SRC" "$LAUNCHER_BIN" || exit 1

  icon=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' \
    "$FIREFOX_APP/Contents/Info.plist" 2>/dev/null || echo firefox)
  src="$FIREFOX_APP/Contents/Resources/${icon%.icns}.icns"
  if [[ -f $src ]]; then
    mkdir -p "$LAUNCHER/Contents/Resources"
    if ! cmp -s "$src" "$LAUNCHER/Contents/Resources/firefox-novpn.icns"; then
      cp "$src" "$LAUNCHER/Contents/Resources/firefox-novpn.icns"
      echo "  → icône du lanceur"
    fi
  else
    echo "  ⚠ icône de Firefox introuvable ($src)" >&2
  fi

  # Signature ad hoc du bundle entier (Info.plist et icône compris),
  # refaite dès qu'un élément change (exécutable, Info.plist, icône)
  if ! codesign --verify "$LAUNCHER" >/dev/null 2>&1; then
    if codesign --force --sign - "$LAUNCHER" >/dev/null 2>&1; then
      touch "$LAUNCHER"
      echo "  → lanceur signé"
    else
      echo "  ⚠ signature du lanceur impossible (codesign)" >&2
    fi
  fi

  # Enregistrement LaunchServices : Spotlight le propose aussitôt, et
  # l'architecture du nouvel exécutable remplace celle mise en cache
  "$LSREGISTER" -f "$LAUNCHER" 2>/dev/null || true
fi

# ── 5. Mullvad ───────────────────────────────────────────────
[[ -x $MULLVAD ]] || {
  echo "  ✗ CLI mullvad introuvable ($MULLVAD) : brew install --cask mullvad-vpn" >&2
  exit 1
}

st=$("$MULLVAD" split-tunnel get)
if ! grep -qxF "$EXCLUDE" <<<"$st"; then
  "$MULLVAD" split-tunnel app add "$EXCLUDE" >/dev/null
  echo "  → $EXCLUDE exclu du tunnel"
fi
if ! grep -qi 'state: on' <<<"$st"; then
  "$MULLVAD" split-tunnel set on >/dev/null
  echo "  → split tunneling activé"
fi

echo "Terminé."
